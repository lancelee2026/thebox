{
  "name": "fan-zhuan-kuai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:xhs": "tsc && node scripts/build-xhs.mjs",
    "validate:xhs": "node scripts/validate-xhs.mjs dist-xhs",
    "package:xhs": "npm run build:xhs && npm run validate:xhs && cd dist-xhs && zip -FSqr ../fan-zhuan-kuai-xhs.zip . -x '*.DS_Store'",
    "preview": "vite preview",
    "check-levels": "tsx scripts/check-levels.ts",
    "dump-par": "tsx scripts/dump-par.ts",
    "dump-paths": "tsx scripts/dump-paths.ts",
    "debug-level": "tsx scripts/debug-level.ts",
    "debug-path": "tsx scripts/debug-path.ts",
    "audit-mechanics": "tsx scripts/audit-mechanics.ts",
    "audit-level-experience": "tsx scripts/audit-level-experience.ts --write",
    "check-level-experience": "tsx scripts/check-level-experience.ts",
    "check-death-feedback": "tsx scripts/check-death-feedback.ts"
  },
  "devDependencies": {
    "@types/three": "^0.185.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "three": "^0.185.1"
  }
}
